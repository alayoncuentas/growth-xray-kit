  "evidence": {
    "schmitt2011": {
      "text": "In a study of about 10,000 customers of a German bank, customers who joined through a referral program were worth at least 16% more than similar customers who didn't. The gap varied by customer segment.",
      "source": "Schmitt, Skiera & Van den Bulte, \"Referral Programs and Customer Value\", Journal of Marketing, 2011",
      "kind": "academic",
      "url": "https://faculty.wharton.upenn.edu/wp-content/uploads/2012/04/Schmitt-Skiera-vandenBulte-2011-Referral-Programs-Customer-Value.pdf"
    },
    "ftc2024": {
      "text": "Since October 21, 2024, an FTC rule bans fake reviews and testimonials, paying for reviews that must say something positive or negative, certain undisclosed reviews from insiders, and threats to get negative reviews removed.",
      "source": "Federal Trade Commission, Rule on the Use of Consumer Reviews and Testimonials (16 CFR Part 465), 2024",
      "kind": "government",
      "url": "https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers"
    }
  },
