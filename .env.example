# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# Supabase → botón "Connect"
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (todavía no se usa en el cliente)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret keys. SECRETA: solo en el servidor.
SUPABASE_SECRET_KEY=

# Opcional: sal para el hash de IP de la limitación de intentos (cualquier texto largo y aleatorio).
IP_HASH_SALT=

# Correos con acceso a /admin (separados por comas). Inician sesión con un enlace mágico de Supabase Auth.
ADMIN_EMAILS=
# URL pública de la app, para los links del CSV y del correo de acceso (en local se usa la del navegador).
NEXT_PUBLIC_APP_URL=

# Resend (correos: informe al terminar la fase 1 y link para retomar). Sin clave, en desarrollo se imprimen en la terminal.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Growth X-Ray <xray@tudominio.com>"
EMAIL_FROM=

# Camino abierto (docs/OPEN_ENTRY.md). Apagado salvo con el valor exacto "true". No encender hasta publicar /privacy.
OPEN_ENTRY_ENABLED=
# Cloudflare Turnstile (widget Managed). En local, las claves de prueba de Cloudflare (siempre pasan):
# site 1x00000000000000000000AA · secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
