# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# Supabase → botón "Connect"
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (todavía no se usa en el cliente)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret keys. SECRETA: solo en el servidor.
SUPABASE_SECRET_KEY=

# Opcional: sal para el hash de IP de la limitación de intentos (cualquier texto largo y aleatorio).
IP_HASH_SALT=
